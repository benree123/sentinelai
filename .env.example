# Copy to .env and use distinct random values. Never commit .env.
# POSTGRES_PASSWORD should use URL-safe letters and digits for the connection URL.
POSTGRES_PASSWORD=replace_with_random_letters_and_digits
SENTINEL_BOOTSTRAP_PASSWORD=replace_with_at_least_12_random_characters
# Optional local Ollama model; no external AI provider is contacted.
# OLLAMA_MODEL=your_installed_model

# Optional email lifecycle. Local demo works without email; recovery/invites do not.
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_FROM=security@your-domain.example
# SMTP_USERNAME=your_smtp_username
# SMTP_PASSWORD=your_smtp_password
# SENTINEL_PUBLIC_URL=https://your-verified-domain.example
# Set true when serving behind HTTPS.
# COOKIE_SECURE=true
# Optional signing key: at least 64 hexadecimal characters. Otherwise data/jwt.key is generated.
# SENTINEL_JWT_KEY=your_64_character_random_hex_key

# Development only. Use compose.production.yaml for HTTPS production configuration.
SENTINEL_ENV=development
COOKIE_SECURE=false
REQUIRE_EMAIL_VERIFICATION=false
# Production requires an HTTPS SENTINEL_PUBLIC_URL and a random signing key.
# Direct registration activates access without claiming email ownership.
